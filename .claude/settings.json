{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git remote -v)",
      "Bash(git show:*)",
      "Bash(npm test:*)",
      "Bash(npm run migrate:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc:*)",
      "Bash(cd apps/settlement && go test:*)",
      "Bash(go test:*)",
      "Bash(docker compose -f ops/docker-compose.yml ps:*)",
      "Bash(docker compose -f ops/docker-compose.prod.yml ps:*)",
      "Bash(docker compose -f ops/docker-compose.yml logs:*)",
      "Bash(docker compose -f ops/docker-compose.prod.yml logs:*)",
      "Read(**)",
      "Glob(**)",
      "Grep(**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Read(ops/.env.prod)",
      "Read(ops/.env.docker)",
      "Read(ops/.env.local)"
    ]
  }
}
