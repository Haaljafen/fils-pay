# Copy to ops/.env.prod on the server and fill in. Generate each secret with: openssl rand -hex 24
POSTGRES_PASSWORD=
SETTLEMENT_INTERNAL_TOKEN=
ACQUIRER_CALLBACK_SIGNING_SECRET=
# exactly 32 random bytes, base64: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=
PUBLIC_URL=http://139.59.66.122
# plain http until TLS is set up; set true once served over https
COOKIE_SECURE=false
OTP_DEV_EXPOSE=false
# There is no email/SMS sender. true writes login codes to the api log (never to a response), so you can log in:
# docker compose -f ops/docker-compose.prod.yml --env-file ops/.env.prod logs --since 5m api | grep 'otp code generated'
# Anyone who can read the logs holds the second factor. Turn it off once a real sender exists.
OTP_LOG_CODE=false
# With OTP_LOG_CODE=true, only these accounts have codes logged (see ops/otp-reveal.README.md).
OTP_LOG_MERCHANT_EMAILS=
OTP_LOG_MERCHANT_USER_IDS=
