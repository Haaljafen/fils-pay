# Settings for the api, settlement, reporting and seed services in
# ops/docker-compose.yml, loaded through each service's `env_file:`.
#
#   cp ops/.env.docker.example ops/.env.docker
#
# ops/.env.docker is gitignored. Put real values only there, never in this
# template.

# development: plain-http cookies, http webhook URLs, OTP code printed in the
# api log. Use production on any hosted box (it requires every secret below
# and serves cookies only over https).
NODE_ENV=development

# true returns the login OTP code in the API response, so the login pages show
# it. Local development only: with it on, a password alone logs anyone in.
# Refused when NODE_ENV=production.
OTP_DEV_EXPOSE=false

# Shared by api (caller) and settlement (server). The settlement daemon exits
# at boot while this is empty. Generate one: openssl rand -hex 32
SETTLEMENT_INTERNAL_TOKEN=

# AES-256 key for stored webhook secrets. Optional in development (a fixed
# dev key is used); required in production. Generate one and keep it:
# openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Public https:// address of the hosted checkout (apps/web). Every payment
# link's URL is built from it. Required in production; defaults to
# http://localhost:5173 in development.
CHECKOUT_BASE_URL=

# Shared secret from the acquirer for signing callbacks. While empty, every
# acquirer callback is rejected. Required in production.
ACQUIRER_CALLBACK_SIGNING_SECRET=
