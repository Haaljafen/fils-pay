# Builds one dashboard (APP=web|admin) into static files and serves them with nginx, which also
# proxies /v1 to the API so the browser sees one origin (the API sends no CORS headers).
FROM node:22-bookworm AS build
ARG APP=web
ARG PUBLIC_WEB_URL=http://localhost
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/reporting/package.json apps/reporting/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY packages/money/package.json packages/money/package.json
COPY packages/events/package.json packages/events/package.json
RUN npm ci --no-audit --no-fund
COPY . .
ENV VITE_API_BASE_URL="" VITE_ADMIN_API_BASE_URL="" VITE_WEB_BASE_URL=${PUBLIC_WEB_URL}
RUN cd apps/${APP} && npx vite build

FROM nginx:1.27-alpine
ARG APP=web
COPY --from=build /app/apps/${APP}/dist /usr/share/nginx/html
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
